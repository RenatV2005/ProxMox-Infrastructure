variable "proxmox_endpoint" {
  description = "Proxmox VE API endpoint"
  type        = string
}

variable "proxmox_api_token" {
  description = "Proxmox VE API token"
  type        = string
  sensitive   = true
}

variable "vm_name" {
  description = "Name of the virtual machine"
  type        = string
}

variable "vm_id" {
  description = "Proxmox VM ID"
  type        = number
}

variable "vm_node" {
  description = "Proxmox node where the VM will run"
  type        = string
}

variable "template_id" {
  description = "Proxmox template VM ID"
  type        = number
}

variable "vm_cores" {
  description = "Number of CPU cores"
  type        = number
}

variable "vm_memory" {
  description = "VM memory in MiB"
  type        = number
}

variable "vm_ip" {
  description = "Static IPv4 address with CIDR prefix"
  type        = string
}

variable "vm_gateway" {
  description = "IPv4 default gateway"
  type        = string
}

variable "vm_username" {
  description = "Initial VM username"
  type        = string
}

variable "vm_password" {
  description = "Initial VM password"
  type        = string
  sensitive   = true
}

variable "vm_ssh_public_key" {
  description = "SSH public key for the VM user"
  type        = string
}

