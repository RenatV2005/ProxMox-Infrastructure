variable "proxmox_endpoint" {
  description = "Proxmox VE API endpoint"
  type        = string
}

variable "proxmox_api_token" {
  description = "Proxmox VE API token"
  type        = string
  sensitive   = true
}
variable "vm_username" {
  type = string
}

variable "vm_password" {
  type      = string
  sensitive = true
}
variable "vm_ssh_public_key" {
  description = "SSH public key for the VM"
  type        = string
}
variable "vm_name" {
  description = "Name der virtuellen Maschine"
  type        = string
}

variable "vm_id" {
  description = "VM ID in Proxmox"
  type        = number
}

variable "vm_node" {
  description = "Proxmox Node"
  type        = string
}

variable "vm_cores" {
  description = "Anzahl der CPU Cores"
  type        = number
}

variable "vm_memory" {
  description = "RAM in MiB"
  type        = number
}

variable "vm_ip_address" {
  description = "IPv4 Adresse mit CIDR"
  type        = string
}

variable "vm_gateway" {
  description = "IPv4 Gateway"
  type        = string
}

variable "vm_username" {
  description = "Cloud-Init Benutzer"
  type        = string
}

variable "vm_password" {
  description = "Cloud-Init Passwort"
  type        = string
  sensitive   = true
}

variable "vm_ssh_key" {
  description = "SSH Public Key für die VM"
  type        = string
}